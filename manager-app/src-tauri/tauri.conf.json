{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IsolatedBrowserManager",
  "version": "1.2.1",
  "identifier": "com.isolatedbrowser.manager",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "node ../scripts/prepare_desktop_build.mjs && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3NzhFMzM4N0FDRUY4MDIKUldRQytNNTZPT040QjFpS0xmTjdxOGNDS3JCT3FZdkx1NHJhaUsybitUczFyMEhFVFVtVHRldWUK",
      "endpoints": [
        "https://github.com/rathana-pvs/anti_bot_browser/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "Isolated Browser Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/*": "binaries/",
      "resources/payload/": "payload/"
    }
  }
}
