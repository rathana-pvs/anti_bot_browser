{
  "$defs": {
    "Authentication": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "json-login",
          "enum": [
            "json-login",
            "basic",
            "bearer"
          ],
          "title": "Type",
          "type": "string"
        },
        "login": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tokenPath": {
          "default": "token",
          "maxLength": 200,
          "title": "Tokenpath",
          "type": "string"
        },
        "header": {
          "default": "Authorization",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$",
          "title": "Header",
          "type": "string"
        },
        "prefix": {
          "default": "Bearer ",
          "maxLength": 50,
          "title": "Prefix",
          "type": "string"
        }
      },
      "title": "Authentication",
      "type": "object"
    },
    "ConnectorSchema": {
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "$ref": "#/$defs/Authentication"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ContentField"
          },
          "maxProperties": 50,
          "title": "Fields",
          "type": "object"
        },
        "operations": {
          "$ref": "#/$defs/Operations"
        },
        "requireAny": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 20,
          "title": "Requireany",
          "type": "array"
        },
        "publicationStatusField": {
          "default": "status",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$",
          "title": "Publicationstatusfield",
          "type": "string"
        },
        "publishedValue": {
          "default": "published",
          "maxLength": 100,
          "minLength": 1,
          "title": "Publishedvalue",
          "type": "string"
        },
        "verifyValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            }
          ],
          "default": true,
          "title": "Verifyvalue"
        },
        "contentFormat": {
          "default": "plain",
          "enum": [
            "plain",
            "html",
            "lexical"
          ],
          "title": "Contentformat",
          "type": "string"
        },
        "catalogArticleMapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Catalogarticlemapping",
          "type": "object"
        },
        "idempotentMutations": {
          "const": true,
          "title": "Idempotentmutations",
          "type": "boolean"
        }
      },
      "required": [
        "authentication",
        "operations",
        "idempotentMutations"
      ],
      "title": "ConnectorSchema",
      "type": "object"
    },
    "ContentField": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "maxLength": 100,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "maxLength": {
          "anyOf": [
            {
              "maximum": 120000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "title": "ContentField",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "encoding": {
          "default": "json",
          "enum": [
            "json",
            "form",
            "multipart"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "query": {
          "additionalProperties": true,
          "title": "Query",
          "type": "object"
        },
        "body": {
          "additionalProperties": true,
          "title": "Body",
          "type": "object"
        },
        "response": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response",
          "type": "object"
        },
        "fileField": {
          "default": "file",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$",
          "title": "Filefield",
          "type": "string"
        },
        "payloadField": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payloadfield"
        },
        "idempotencyHeader": {
          "default": "Idempotency-Key",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$",
          "title": "Idempotencyheader",
          "type": "string"
        },
        "urlTemplate": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urltemplate"
        }
      },
      "required": [
        "path"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Operations": {
      "additionalProperties": false,
      "properties": {
        "test": {
          "$ref": "#/$defs/Operation"
        },
        "publish": {
          "$ref": "#/$defs/Operation"
        },
        "verify": {
          "$ref": "#/$defs/Operation"
        },
        "commentLink": {
          "$ref": "#/$defs/Operation"
        },
        "upload": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "update": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "test",
        "publish",
        "verify",
        "commentLink"
      ],
      "title": "Operations",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "default": 1,
      "maximum": 2,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "$schema": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "baseUrl": {
      "maxLength": 2048,
      "title": "Baseurl",
      "type": "string"
    },
    "adapter": {
      "default": "payload-news-v1",
      "pattern": "^(payload-news-v1|http-json-v1)$",
      "title": "Adapter",
      "type": "string"
    },
    "schema": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectorSchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "email": {
      "default": "",
      "maxLength": 254,
      "title": "Email",
      "type": "string"
    },
    "username": {
      "default": "",
      "maxLength": 254,
      "title": "Username",
      "type": "string"
    },
    "password": {
      "format": "password",
      "title": "Password",
      "type": "string",
      "writeOnly": true
    },
    "api_token": {
      "format": "password",
      "title": "Api Token",
      "type": "string",
      "writeOnly": true
    }
  },
  "required": [
    "name",
    "baseUrl"
  ],
  "title": "Connector",
  "type": "object"
}
